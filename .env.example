# ---------------------------------------------------------------------------
# Supabase — client (browser) configuration
#
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# Only VITE_-prefixed vars are exposed to the browser by Vite. That is CORRECT
# here: the anon key is a PUBLIC key. Your data is protected by Row Level
# Security (RLS) in the database, NOT by hiding this key.
#
# NEVER put the Supabase `service_role` key in this file or anywhere in the
# frontend — it bypasses RLS. It belongs only in trusted server environments.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
